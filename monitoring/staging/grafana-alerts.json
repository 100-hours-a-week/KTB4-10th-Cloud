{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "staging-eks",
      "folder": "KGB Staging EKS",
      "interval": "1m",
      "rules": [
        {
          "uid": "kgb-stg-api-unavailable",
          "title": "API Pod unavailable",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "editorMode": "code",
                "expr": "max by(namespace)(kube_deployment_status_replicas_available{cluster=\"kgb-staging-eks\",namespace=~\"auth|guidebook\"}) or on(namespace) label_replace(vector(0),\"namespace\",\"auth\",\"\",\".*\") or on(namespace) label_replace(vector(0),\"namespace\",\"guidebook\",\"\",\".*\")",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "type": "threshold",
                "expression": "A",
                "refId": "B",
                "conditions": [
                  {
                    "type": "query",
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        1
                      ]
                    },
                    "operator": {
                      "type": "and"
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "2m",
          "isPaused": false,
          "labels": {
            "environment": "staging",
            "cluster": "kgb-staging-eks",
            "severity": "critical",
            "team": "cloud"
          },
          "annotations": {
            "summary": "Auth 또는 Guidebook의 사용 가능한 Pod가 2분 이상 없습니다.",
            "description": "Deployment/Pod 이벤트와 startup·readiness probe, 애플리케이션 로그를 확인하세요.",
            "runbook_url": "https://github.com/100-hours-a-week/KTB4-10th-Cloud/blob/main/monitoring/staging/README.md"
          },
          "notification_settings": {
            "receiver": "staging-alerts",
            "group_by": [
              "alertname",
              "namespace"
            ],
            "group_wait": "30s",
            "group_interval": "5m",
            "repeat_interval": "1h"
          }
        },
        {
          "uid": "kgb-stg-scheduler-unavailable",
          "title": "Scheduler Pod unavailable",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "editorMode": "code",
                "expr": "max by(namespace)(kube_deployment_status_replicas_available{cluster=\"kgb-staging-eks\",namespace=~\"kgb-ops\"}) or on(namespace) label_replace(vector(0),\"namespace\",\"kgb-ops\",\"\",\".*\")",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "type": "threshold",
                "expression": "A",
                "refId": "B",
                "conditions": [
                  {
                    "type": "query",
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        1
                      ]
                    },
                    "operator": {
                      "type": "and"
                    }
                  }
                ]
              }
            }
