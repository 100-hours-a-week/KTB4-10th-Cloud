          "noDataState": "OK",
          "execErrState": "Error",
          "for": "5m",
          "isPaused": false,
          "labels": {
            "environment": "staging",
            "cluster": "kgb-staging-eks",
            "severity": "warning",
            "team": "cloud"
          },
          "annotations": {
            "summary": "Scheduler의 사용 가능한 Pod가 5분 이상 없습니다.",
            "description": "Pod 상태·로그를 확인하세요. 이 규칙은 수집 작업의 성공 여부를 판단하지 않습니다.",
            "runbook_url": "https://github.com/100-hours-a-week/KTB4-10th-Cloud/blob/main/monitoring/staging/README.md"
          },
          "notification_settings": {
            "receiver": "staging-alerts",
            "group_by": [
              "alertname",
              "namespace"
            ],
            "group_wait": "30s",
            "group_interval": "5m",
            "repeat_interval": "4h"
          }
        },
        {
          "uid": "kgb-stg-http-5xx",
          "title": "API HTTP 5xx increased",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "editorMode": "code",
                "expr": "((sum by(namespace)(increase(http_server_requests_seconds_count{cluster=\"kgb-staging-eks\",namespace=~\"auth|guidebook\",uri!~\"/actuator.*\",status=~\"5..\"}[5m])) or on(namespace) (0 * sum by(namespace)(increase(http_server_requests_seconds_count{cluster=\"kgb-staging-eks\",namespace=~\"auth|guidebook\",uri!~\"/actuator.*\"}[5m])))) / clamp_min(sum by(namespace)(increase(http_server_requests_seconds_count{cluster=\"kgb-staging-eks\",namespace=~\"auth|guidebook\",uri!~\"/actuator.*\"}[5m])),1)) * on(namespace) (sum by(namespace)(increase(http_server_requests_seconds_count{cluster=\"kgb-staging-eks\",namespace=~\"auth|guidebook\",uri!~\"/actuator.*\"}[5m])) >= bool 20)",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "type": "threshold",
                "expression": "A",
                "refId": "B",
                "conditions": [
                  {
                    "type": "query",
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.05
                      ]
                    },
                    "operator": {
                      "type": "and"
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "2m",
          "isPaused": false,
          "labels": {
            "environment": "staging",
            "cluster": "kgb-staging-eks",
            "severity": "critical",
            "team": "cloud"
          },
          "annotations": {
            "summary": "최근 5분 요청이 20건 이상이며 5xx 비율이 5%를 초과한 상태가 2분 지속됐습니다.",
            "description": "Guidebook/Auth 로그와 DB·외부 서비스 상태를 확인하세요. 401·404는 5xx에 포함되지 않습니다.",
            "runbook_url": "https://github.com/100-hours-a-week/KTB4-10th-Cloud/blob/main/monitoring/staging/README.md"
          },
          "notification_settings": {
            "receiver": "staging-alerts",
            "group_by": [
              "alertname",
              "namespace"
            ],
            "group_wait": "30s",
            "group_interval": "5m",
            "repeat_interval": "1h"
          }
        },
